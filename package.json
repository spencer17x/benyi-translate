{
  "name": "benyi-translate",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm run format:check && pnpm run check:code && pnpm run build",
    "check:code": "pnpm run typecheck && pnpm test",
    "fixture": "node scripts/serve-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm run check && pnpm run package:artifact",
    "package:artifact": "node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tabler/icons": "3.44.0",
    "@types/chrome": "^0.2.2",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "prettier": "3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
